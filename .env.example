# Discord bot token (https://discord.com/developers/applications -> Bot -> Reset Token)
DISCORD_TOKEN=

# Optional: a server (guild) ID for instant slash-command sync while developing.
# Leave empty to sync globally (can take up to an hour to appear).
DEV_GUILD_ID=

# Servers (guild IDs, comma separated) she may be in. If anyone adds her to another server,
# she leaves at once. Strongly recommended: your bot uses your API keys wherever it is.
# Also turn off "Public Bot" on the Bot page of the Developer Portal, so only you can invite her.
# Empty = no restriction.
ALLOWED_GUILD_IDS=

# Main platform for searches by song name: bilibili | netease | siren (YouTube takes links only)
DEFAULT_SOURCE=bilibili

# Default volume, 0-100
DEFAULT_VOLUME=50

# Leave the voice channel after this many seconds with nothing playing
IDLE_TIMEOUT=300

# ---- NetEase Cloud Music ----
# NetEase blocks most playback from outside mainland China. If the bot runs overseas,
# point this at a proxy located in China, e.g. http://127.0.0.1:7890
NETEASE_PROXY=
# Optional: your own account's MUSIC_U cookie value, for songs your account is entitled to
NETEASE_MUSIC_U=
# When a NetEase song can't be played, search these platforms (in order of preference) for the
# same song and play that instead. Leave empty to just skip the song.
NETEASE_FALLBACK=bilibili

# ---- Bilibili ----
# Optional: the SESSDATA cookie of your own logged-in account (higher audio quality,
# fewer rate limits). Works without it.
BILIBILI_SESSDATA=

# ---- YouTube ----
# Optional: cookies.txt for YouTube if you hit "Sign in to confirm you're not a bot".
YOUTUBE_COOKIES=

# ---- Priestess chat ----
# @mention the bot to talk to Priestess. Set one key; leave both empty to turn chat off
# (music keeps working either way).
# DeepSeek: key from https://platform.deepseek.com. Used first when set.
DEEPSEEK_API_KEY=
# Claude: key from https://platform.claude.com.
ANTHROPIC_API_KEY=
# Optional: deepseek | claude, when both keys are set.
CHAT_PROVIDER=
# Empty = the provider's default. DeepSeek: deepseek-flash (default) or deepseek-v4-pro (pricier, slower).
# Claude: claude-opus-5-5 (default), claude-sonnet-5-5 or claude-haiku-5-5 (cheaper).
CHAT_MODEL=
# How much she thinks before answering: low | medium | high. low suits chat.
CHAT_EFFORT=low
# Let her search the web (and read pages people link) for fresh information: on | off.
# With DeepSeek this uses its Search API: about US$0.001-0.002 per search, tokens included.
# CHAT_SEARCH_MAX_USES is per message.
CHAT_WEB_SEARCH=on
CHAT_SEARCH_MAX_USES=2
# Web searches (and live lookups) per person per day. The deployer (the bot application's
# owner in the Developer Portal) has no daily limit, but SERPAPI_MONTHLY_LIMIT applies to everyone.
CHAT_SEARCH_DAILY=20
# Optional: live data from Google through SerpApi: flights (and cheapest dates, deals), hotels,
# product prices, Google Maps places and directions, and Google Lens for pictures.
# Free key at https://serpapi.com (250 searches a month). Each lookup also counts as a search.
SERPAPI_KEY=
# Stop at this many lookups a month, so the free 250 are never exceeded.
SERPAPI_MONTHLY_LIMIT=230
# Optional: channel IDs (comma separated) where she answers every message without an @mention.
# Requires turning on "Message Content Intent" in the Developer Portal (Bot page).
CHAT_CHANNEL_IDS=
# Daily limits on messages sent to the chat API (0 = no limit), for every server together. The
# deployer has no limits; a server's owner has no per-person limit, but the server-wide one
# still applies to them. Past it she only answers with pre-written lines.
CHAT_USER_DAILY=40
CHAT_SERVER_DAILY=500
# Longer messages get a "too long" line instead of an API call.
CHAT_MAX_INPUT_CHARS=1500
# Homework, essays, letters, code, translations and other long tasks per person per day.
CHAT_TASKS_DAILY=3
# A channel's conversation starts over after this many messages (less history = cheaper).
CHAT_MAX_MESSAGES=40
# logs/blocked.log keeps only the time, kind, matched word and channel of blocked messages.
# on = also the speaker's name and the first 200 characters (may be very personal).
LOG_BLOCKED_TEXT=off
# Answer short reactions ("哈哈", "？", "好耶") with her app emojis instead of the API: on | off
CHAT_STICKERS=on
# Seconds between two stickers in the same channel (extra reactions are ignored, for free).
STICKER_COOLDOWN=5
# DeepSeek balance (/余额): how often it's read (minutes), and the amount (in your account's
# currency, e.g. yuan) below which the deployer gets a DM. 0 = no DM.
BALANCE_CHECK_MINUTES=30
BALANCE_WARN=10

# ---- Her voice (GPT-SoVITS) ----
# Voice settings: a JSON file like voices/example.json (your GPT-SoVITS folder, model weights,
# reference clip). Empty = voices/voice.json. No such file = talk mode is off.
VOICE_CONFIG=
# Reference text: clip = the clip's own words (t1, follows the clip's intonation too),
# none = no text (t4, only its timbre), empty = what VOICE_CONFIG says.
VOICE_PROMPT=clip
# Stop GPT-SoVITS after this many minutes with nobody in talk mode (frees the GPU).
SOVITS_IDLE_MINUTES=5

# ---- Game calendar (游时 Playtime) ----
# Playtime's folder. It is started hidden once to sync (when the bot starts, then every
# PLAYTIME_REFRESH_HOURS), and closed right after. Empty = ../Playtime-v0.2.0-windows-x64
PLAYTIME_DIR=
PLAYTIME_REFRESH_HOURS=24
# Channel for event reminders and the daily digest (right-click the channel -> Copy ID).
# Empty = no reminders; /活动 still works.
CALENDAR_CHANNEL_ID=
# Games to remind about: arknights-cn, endfield-cn, azurlane-cn, zzz-cn, nikke-global
CALENDAR_GAMES=arknights-cn,endfield-cn
# Time of the daily posts (one per game), in this computer's time zone: what's running and how
# long is left, what starts tomorrow, and what ends in the next CALENDAR_END_DAYS days.
CALENDAR_DIGEST_TIME=20:00
# Something ending on day D is listed in the posts of this many evenings before D.
CALENDAR_END_DAYS=3
CALENDAR_START_DAYS=1
# Last-call alerts 24 h and 1 h before activities and exchange shops end: on | off
CALENDAR_ALERTS=on
# Optional: a role to @ in reminders (role ID). Empty = no pings.
CALENDAR_PING_ROLE_ID=
